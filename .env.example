# Kopieer naar .env.local (staat in .gitignore) en vul de waarden uit je Supabase-project in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mailen vanuit het CRM (Resend). Alleen op de server, nooit met NEXT_PUBLIC_ ervoor. In Vercel als Sensitive instellen.
RESEND_API_KEY=

# Nodig voor de meldingsmail aan medewerkers (de klant is niet ingelogd). Alleen op de server, nooit met NEXT_PUBLIC_ ervoor; in Vercel als Sensitive instellen.
SUPABASE_SERVICE_ROLE_KEY=
# Optioneel: vast adres van het CRM voor links in mails (https://...). Anders wordt het productieadres van Vercel gebruikt.
CRM_BASIS_URL=
